{
  "rewrites": [
    { "source": "/api/sync-alertas", "destination": "https://conectagestao360.vercel.app/api/sync-alertas" },
    { "source": "/api/process-queue", "destination": "https://conectagestao360.vercel.app/api/process-queue" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
